{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk3",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "ags/*": ["./node_modules/ags/lib/*"],
      "gnim/*": ["./node_modules/gnim/lib/*"]
    }
  }
}
